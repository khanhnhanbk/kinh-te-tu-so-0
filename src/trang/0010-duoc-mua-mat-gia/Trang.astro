function so(v) { return v.toLocaleString("vi-VN", { maximumFractionDigits: 2 }); }
function toiThieu() { return Math.ceil(CAN / q / 5) * 5; }
function docN() { var e = o("t10l-n"), v = parseInt(e.value, 10); if (isNaN(v)) v = 80; v = Math.round(v / 5) * 5; return Math.min(DAN, Math.max(toiThieu(), v)); }
function tinh(n) {
  var lua = n * q * (duocMua ? 1.5 : 1), gia = CAN / lua, tong = CAN * gia;
  return { lua: lua, gia: gia, tong: tong, nd: tong / n };
}
var luoi = o("t10l-luoi");
for (var i = 0; i < DAN; i++) luoi.appendChild(document.createElement("span"));
function ve() {
  var n = docN(); o("t10l-n").value = n;
  var r = tinh(n), thua = r.lua - CAN;
  Array.prototype.forEach.call(luoi.children, function (s, k) {
    var ruong = k < n; s.textContent = ruong ? "🌾" : "🛠️"; s.className = ruong ? "lam-ruong" : "lam-dich-vu";
  });
  o("t10l-lua").textContent = "Lúa làm ra: " + so(r.lua) + " phần. Cả làng ăn 400 phần" + (thua > 0 ? ", thừa " + so(thua) + " phần bỏ đi. Giá 1 phần: " + so(r.gia) + "\u00a0đồng." : ", vừa đủ. Giá 1 phần: 1 đồng.");
  var max = Math.max(40, r.nd, CONG_DV);
  o("t10l-thanh-nd").style.width = (r.nd / max * 100) + "%";
  o("t10l-thanh-dv").style.width = (CONG_DV / max * 100) + "%";
  o("t10l-nd").textContent = so(r.nd) + "\u00a0đồng";
  o("t10l-dv").textContent = CONG_DV + "\u00a0đồng";
  var hoa = Math.sqrt(CAN * CAN / (q * (duocMua ? 1.5 : 1) * CONG_DV)), ket;
  if (r.nd < CONG_DV * 0.95) ket = "<b>Nông dân nghèo hơn:</b> " + so(r.nd) + "\u00a0đồng so với " + CONG_DV + "\u00a0đồng. ";
  else if (r.nd > CONG_DV * 1.05) ket = "<b>Nông dân khá hơn:</b> " + so(r.nd) + "\u00a0đồng so với " + CONG_DV + "\u00a0đồng. ";
  else ket = "<b>Gần bằng nhau:</b> " + so(r.nd) + "\u00a0đồng so với " + CONG_DV + "\u00a0đồng. ";
  if (hoa < toiThieu()) ket += "Với nông cụ này phải có ít nhất " + toiThieu() + " người làm ruộng thì làng mới đủ ăn, nên mỗi nông dân kiếm nhiều nhất " + so(tinh(toiThieu()).nd) + "\u00a0đồng.";
  else ket += "Với nông cụ này, nông dân kiếm bằng người làm dịch vụ khi còn khoảng " + Math.round(hoa) + " người ở lại ruộng" + (n > hoa ? ": còn " + (n - Math.round(hoa)) + " người nữa phải rời ruộng." : n < hoa - 0.5 ? ". Làng đang có ít người làm ruộng hơn mức đó, nên mỗi người được nhiều hơn." : ".");
  if (duocMua) ket += " Được mùa: lúa nhiều gấp rưỡi, còn tiền thu về chỉ bằng hai phần ba năm thường.";
  o("t10l-ket").innerHTML = ket;
}
function chonCu(qMoi) {
  q = qMoi;
  o("t10l-cu").querySelectorAll(".chip").forEach(function (b) { b.setAttribute("aria-pressed", String(+b.getAttribute("data-q") === q)); });
  o("t10l-n").min = toiThieu();
}
function boCanh() { o("t10l-canh").querySelectorAll(".chip").forEach(function (b) { b.setAttribute("aria-pressed", "false"); }); }
o("t10l-canh").querySelectorAll(".chip").forEach(function (b) {
  b.addEventListener("click", function () {
    chonCu(+b.getAttribute("data-q")); o("t10l-n").value = b.getAttribute("data-n");
    boCanh(); b.setAttribute("aria-pressed", "true"); ve();
  });
});
o("t10l-cu").querySelectorAll(".chip").forEach(function (b) {
  b.addEventListener("click", function () { chonCu(+b.getAttribute("data-q")); boCanh(); ve(); });
});
document.querySelectorAll("#t10l .o-so button").forEach(function (b) {
  b.addEventListener("click", function () {
    var e = o(b.getAttribute("data-o")); e.value = docN() + (b.classList.contains("cong") ? 5 : -5); boCanh(); ve();
  });
});
o("t10l-n").addEventListener("change", function () { boCanh(); ve(); });
o("t10l-mua").addEventListener("click", function () {
  duocMua = !duocMua; o("t10l-mua").setAttribute("aria-pressed", String(duocMua)); ve();
});
ve();
})();
</script>
