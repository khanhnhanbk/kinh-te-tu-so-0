  var c = ev.target.closest(".chip"); if (!c) return;
  var m = MON[+c.getAttribute("data-i")], t = c.getAttribute("data-t"); m[t] = !m[t]; veChip(); dung(); datLai();
});
veChip();

for (var i = 0; i < N; i++) { var s = document.createElement("span"); luoi.appendChild(s); }
var o100 = luoi.children;

function rng(seed) { var x = seed >>> 0; return function () { x = (x * 1664525 + 1013904223) >>> 0; return x / 4294967296; }; }
function taoCho(seed, giantiep) {
  var r = rng(seed), P = [], W = [], H = [], A = [], M = [];
  for (var i = 0; i < N; i++) {
    P[i] = i % G; var w; do { w = Math.floor(r() * G); } while (w === P[i]);
    W[i] = w; H[i] = P[i]; A[i] = 0; M[i] = chiuGiu(Math.floor(r() * G));
  }
  return { r: r, P: P, W: W, H: H, A: A, M: M, gt: giantiep };
}
function trongSo(g) { return (MON[g].ben ? 1 : 0.15) * (MON[g].gon ? 1 : 0.55); }
/* Món mau hỏng thì không ai dám cầm để đổi tiếp: -1 là không nhận món trung gian nào. */
function chiuGiu(g) { return trongSo(g) >= 0.3 ? g : -1; }
function motNgay(c) {
  var r = c.r, H = c.H, W = c.W, P = c.P, A = c.A, M = c.M, an = 0, ord = [], i, k, q;
  function nhan(x, y) { return H[y] === W[x] || (c.gt && H[y] === M[x] && H[x] !== M[x]); }
  for (i = 0; i < N; i++) ord.push(i);
  for (k = 0; k < 4; k++) {
    for (i = N - 1; i > 0; i--) { var j = Math.floor(r() * (i + 1)), t = ord[i]; ord[i] = ord[j]; ord[j] = t; }
    for (q = 0; q < N; q += 2) {
      var a = ord[q], b = ord[q + 1];
      if (H[a] !== H[b] && nhan(a, b) && nhan(b, a)) {
        var tm = H[a]; H[a] = H[b]; H[b] = tm; A[a] = 0; A[b] = 0;
        [a, b].forEach(function (x) { if (H[x] === W[x]) { an++; H[x] = P[x]; } });
      }
    }
  }
  for (i = 0; i < N; i++) { A[i]++; if (H[i] !== P[i] && !MON[H[i]].ben && A[i] > 1) { H[i] = P[i]; A[i] = 0; } }
  if (c.gt) {
    var M2 = M.slice();
    for (i = 0; i < N; i++) {
      if (r() < 0.3) {
        var dem = []; for (k = 0; k < G; k++) dem.push(0);
        if (M[i] >= 0) dem[M[i]] += 1; for (k = 0; k < 4; k++) { var hx = M[Math.floor(r() * N)]; if (hx >= 0) dem[hx]++; }
        var tot = 0, tv = -1; for (k = 0; k < G; k++) { var v = dem[k] * trongSo(k) + r() * 0.01; if (v > tv) { tv = v; tot = k; } }
        M2[i] = dem[tot] ? chiuGiu(tot) : M[i];
      }
      if (r() < 0.004) M2[i] = chiuGiu(Math.floor(r() * G));
    }
    for (i = 0; i < N; i++) M[i] = M2[i];
  }
  return an;
}

var choGT, choTH, ngay, dsGT, dsTH, hen = null;
function veLuoi() { for (var i = 0; i < N; i++) o100[i].textContent = choGT.M[i] >= 0 ? MON[choGT.M[i]].e : "·"; }
function datLai() {
  choGT = taoCho(hat, true); choTH = taoCho(hat, false); ngay = 0; dsGT = []; dsTH = [];
  veLuoi(); o("t6c-ngay").textContent = "0"; o("t6c-gt").textContent = "0"; o("t6c-th").textContent = "0";
  veBD(); ket.textContent = "Bấm “Mở chợ 40 ngày”."; o("t6c-mo").textContent = "Mở chợ 40 ngày";
}
function dung() { if (hen) { clearInterval(hen); hen = null; } }
function buoc() {
  ngay++; var a = motNgay(choGT), b = motNgay(choTH); dsGT.push(a); dsTH.push(b);
  veLuoi(); o("t6c-ngay").textContent = ngay; o("t6c-gt").textContent = a; o("t6c-th").textContent = b; veBD();
  if (ngay >= NGAY) { dung(); ketLuan(); }
}
function tb(ds) { var t = 0, n = Math.min(10, ds.length); for (var i = ds.length - n; i < ds.length; i++) t += ds[i]; return t / n; }
function ketLuan() {
  var dem = []; for (var k = 0; k < G; k++) dem.push(0);
  choGT.M.forEach(function (m) { if (m >= 0) dem[m]++; });
  var top = 0; for (k = 1; k < G; k++) if (dem[k] > dem[top]) top = k;
  var gt = Math.round(tb(dsGT)), th = Math.round(tb(dsTH)), lan = th ? (gt / th).toFixed(1).replace(".", ",") : "";
  var so = "10 ngày cuối, mỗi ngày trung bình " + gt + " người có được thứ mình cần, so với " + th + " người nếu chỉ đổi thẳng" + (lan ? " (gấp " + lan + " lần)." : ".");
  if (dem[top] >= 80) ket.innerHTML = "<b>Ngày " + ngay + ": " + dem[top] + "/100 người cùng nhận " + MON[top].e + " " + MON[top].k + ".</b> Không ai ra lệnh, " + MON[top].k + " tự thành tiền. " + so;
  else if (!dem[top]) ket.innerHTML = "<b>Không món nào thành tiền:</b> món nào cũng mau hỏng, không ai dám cầm để đổi tiếp. Ô có dấu chấm là người chỉ chịu đổi thẳng. " + so;
  else ket.innerHTML = "<b>Chưa món nào thành tiền:</b> nhiều nhất là " + MON[top].e + " " + MON[top].k + " với " + dem[top] + "/100 người. " + so;
  o("t6c-mo").textContent = "Mở lại chợ này";
}
function veBD() {
  while (bd.lastChild && bd.lastChild.nodeName !== "title") bd.removeChild(bd.lastChild);
  var W = 600, H = 200, L = 34, R = 10, T = 12, B = 26, max = 50;
  function x(i) { return L + (W - L - R) * i / (NGAY - 1); }
  function y(v) { return T + (H - T - B) * (1 - Math.min(v, max) / max); }
  function el(t, at, txt) { var e = document.createElementNS(NS, t); for (var a in at) e.setAttribute(a, at[a]); if (txt != null) e.textContent = txt; bd.appendChild(e); return e; }
  [0, 25, 50].forEach(function (v) { el("line", { x1: L, x2: W - R, y1: y(v), y2: y(v), "class": "luoi" }); el("text", { x: L - 6, y: y(v) + 4, "text-anchor": "end", "class": "truc" }, v); });
  [1, 10, 20, 30, 40].forEach(function (d, k, ds) { el("text", { x: x(d - 1), y: H - 8, "text-anchor": k === ds.length - 1 ? "end" : "middle", "class": "truc" }, "ngày " + d); });
  [[dsTH, "an"], [dsGT, "chi"]].forEach(function (p) {
    if (p[0].length) el("polyline", { points: p[0].map(function (v, i) { return x(i) + "," + y(v); }).join(" "), "class": "duong " + p[1] });
  });
}
o("t6c-mo").addEventListener("click", function () {
  dung(); if (ngay >= NGAY) datLai();
  var tat = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (tat) { while (ngay < NGAY) buoc(); return; }
  o("t6c-mo").textContent = "Đang họp chợ…";
  hen = setInterval(buoc, 140);
});
o("t6c-lai").addEventListener("click", function () { dung(); hat = (hat * 7 + 3) % 1000 + 1; datLai(); });
datLai();
})();

