<script is:inline>
(function () {
/* Trang 12: 100 người hỏi 3 câu với một tờ giấy nợ: được đòi không, tin người nợ không, có phải đọc kỹ không. */
var boTen = false, chuan = false, nguoiNo = "an";
function o(id) { return document.getElementById(id); }
function quenAn(i) { return i < 10; }                 /* 10 người quen An, người số 0 là Bình */
function tinKho(i) { return (i * 37) % 100 < 70; }    /* 70 người tin kho muối */
function ranh(i) { return (i * 53 + 11) % 100 < 30; } /* 30 người có thì giờ đọc kỹ từng tờ */
var luoi = o("t12g-luoi");
for (var i = 0; i < 100; i++) luoi.appendChild(document.createElement("span"));
function toGiay() {
  var ai = nguoiNo === "an" ? "An" : nguoiNo === "kho" ? "Kho muối" : "Nhà nước";
  var mon = nguoiNo === "an" ? "bó rau" : nguoiNo === "kho" ? "bao muối" : "đồng";
  if (nguoiNo === "nn" && boTen && chuan) return "<b>TỜ 20 ĐỒNG</b><br>Dùng để nộp thuế và trả mọi khoản nợ trong nước.<small>Không tên, không lãi, không hạn. Đây là tiền giấy.</small>";
  var cho = boTen ? "cho người cầm tờ này" : "cho Bình";
  var khi = chuan ? "khi người đó đòi" : "sau mùa cá, kèm lãi 2 " + mon;
  var so = chuan ? "20 " + mon : "24 " + mon;
  if (nguoiNo === "nn") return ai + " sẽ trả " + so + " " + cho + " " + khi + ". Nhận tờ này khi thu thuế.<small>" + [boTen ? "" : "Còn ghi tên người nhận.", chuan ? "" : "Mỗi tờ một hạn, một mức lãi."].filter(Boolean).join("<br>") + "</small>";
  return ai + " sẽ trả " + so + " " + cho + " " + khi + ".<small>" + (boTen ? "Không ghi tên người nhận." : "Ghi tên người nhận.") + "<br>" + (chuan ? "Tờ nào như tờ nấy." : "Mỗi tờ một hạn, một mức lãi.") + "</small>";
}
function ve() {
  var dem = { nhan: 0, ten: 0, tin: 0, ngai: 0 };
  Array.prototype.forEach.call(luoi.children, function (s, i) {
    var c1 = boTen || i === 0;
    var c2 = nguoiNo === "an" ? quenAn(i) : nguoiNo === "kho" ? tinKho(i) : true;
    var c3 = chuan || ranh(i);
    if (!c1) { s.textContent = "✍️"; s.className = "da-di"; dem.ten++; }
    else if (!c2) { s.textContent = "🤨"; s.className = "da-di"; dem.tin++; }
    else if (!c3) { s.textContent = "🔍"; s.className = "da-di"; dem.ngai++; }
    else { s.textContent = "🤝"; s.className = "la-tien"; dem.nhan++; }
  });
  o("t12g-nhan").textContent = dem.nhan; o("t12g-vuong-ten").textContent = dem.ten;
  o("t12g-khong-tin").textContent = dem.tin; o("t12g-ngai").textContent = dem.ngai;
  o("t12g-to").innerHTML = toGiay();
  var ket;
  if (dem.nhan === 100) ket = "<b>100 người nhận: đây là tiền giấy.</b> Vẫn là một lời hứa trả, nhưng không ghi tên ai, tờ nào như tờ nấy, và người hứa là người cả chợ cần.";
  else if (dem.nhan <= 1) ket = "<b>Chỉ Bình nhận.</b> Đây là một phiếu nợ bình thường: giấy ghi tên Bình nên người khác cầm cũng không đòi được.";
  else {
    var vuong = dem.ten >= dem.tin && dem.ten >= dem.ngai ? "giấy còn ghi tên người nhận" : dem.tin >= dem.ngai ? "nhiều người không tin người nợ" : "mỗi tờ một kiểu nên nhiều người ngại đọc kỹ";
    ket = "<b>" + dem.nhan + " người nhận.</b> Tờ giấy đã đi được nhiều tay hơn, nhưng chưa phải tiền giấy. Chỗ vướng lớn nhất: " + vuong + ".";
  }
  o("t12g-ket").innerHTML = ket;
}
o("t12g-ten").addEventListener("click", function () { boTen = !boTen; this.setAttribute("aria-pressed", String(boTen)); ve(); });
