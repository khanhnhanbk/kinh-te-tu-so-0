        <path d="M398 198c-34 26-122 26-156 0"/><path d="M250 208l-8-10 12-3"/>
      </g>
      <text x="320" y="136" text-anchor="middle" font-family="Be Vietnam Pro, system-ui, sans-serif" font-size="12" fill="#7fbf6a">phần ăn →</text>
