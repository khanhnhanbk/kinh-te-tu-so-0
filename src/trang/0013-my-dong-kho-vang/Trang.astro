    "từ 35 đô la một ounce năm 1971 lên hơn 2.000 đô la từ năm 2020." ] }
];
var bat = [true, true, true, true, false];
function o(id) { return document.getElementById(id); }
var DAU = ["❌", "➖", "✅"];
function ve() {
  var qua = [], dong = "";
  UV.forEach(function (u) {
    var chuoi = "", ok = true;
    bat.forEach(function (b, k) { if (b) { chuoi += DAU[u.d[k]]; if (u.d[k] < 2) ok = false; } });
    if (ok) qua.push(u.ten);
    dong += "<tr><td>" + u.ten + "</td><td>" + (chuoi || "—") + "</td><td>" + (ok ? "✅ Qua" : "Chưa") + "</td></tr>";
  });
  o("t13c-bang").innerHTML = dong;
  var soBat = bat.filter(Boolean).length, ket;
  if (soBat === 0) ket = "<b>Chưa bật tiêu chí nào.</b> Thứ gì cũng giữ được, kể cả vỏ ốc.";
  else if (qua.length === 0) ket = "<b>Không ai qua hết.</b> Không có đồng tiền hoàn hảo. Ngân hàng trung ương phải chọn thứ thiếu ít nhất, và thường chia ra giữ nhiều thứ.";
  else if (qua.length === 1) ket = "<b>Chỉ còn " + qua[0] + ".</b> " + (qua[0] === "Đô la Mỹ" ? "Đây là lý do đô la vẫn đứng đầu: không phải vì nó giữ giá tốt nhất, mà vì những thứ khác còn thiếu nhiều hơn." : qua[0] === "Vàng" ? "Vàng thắng khi bạn chỉ cần giữ giá, không cần dùng hay sinh lãi. Vì vậy các nước vẫn giữ một phần dự trữ bằng vàng." : "Thử bật thêm tiêu chí xem nó còn đứng được không.");
  else ket = "<b>" + qua.join(", ") + " cùng qua.</b> Bật thêm tiêu chí để thấy ai rớt trước.";
  o("t13c-ket").innerHTML = ket;
  var ly = "";
  TEN_TC.forEach(function (t, k) {
    ly += "<li><strong>" + t + ":</strong> " + UV.map(function (u) { return u.ten + " " + DAU[u.d[k]] + " " + u.ly[k]; }).join(" ") + "</li>";
  });
  o("t13c-ly-do").innerHTML = ly;
}
o("t13c-tieu-chi").querySelectorAll(".chip").forEach(function (b) {
  b.addEventListener("click", function () {
    var k = +b.getAttribute("data-tc"); bat[k] = !bat[k]; b.setAttribute("aria-pressed", String(bat[k])); ve();
  });
});
ve();
})();
</script>
