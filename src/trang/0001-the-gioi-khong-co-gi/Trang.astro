        <g class="nguoi"><circle cx="300" cy="186" r="4.2" fill="#f4efe6"/><path d="M300 191v12M294 196h12M300 203l-5 8M300 203l5 8" stroke="#f4efe6" stroke-width="2.2" stroke-linecap="round"/></g>
