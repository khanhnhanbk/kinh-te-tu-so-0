      </g>
      <circle cx="320" cy="172" r="126" fill="none" stroke="#8fc3dd" stroke-opacity=".35" stroke-width="1.5"/>
      <g font-family="Be Vietnam Pro, system-ui, sans-serif" font-size="13" fill="var(--troi-chu)">
        <text x="470" y="132">cây táo dại</text><line x1="466" y1="128" x2="344" y2="148" stroke="var(--troi-chu)" stroke-opacity=".4"/>
        <text x="470" y="214">một mạch vàng</text><line x1="466" y1="210" x2="388" y2="208" stroke="var(--troi-chu)" stroke-opacity=".4"/>
        <text x="58" y="176">một con sông</text><line x1="150" y1="172" x2="262" y2="160" stroke="var(--troi-chu)" stroke-opacity=".4"/>
      </g>
