---
// Trang 1: Thế giới không có gì cả. Câu hỏi, số dân, trang cha nằm ở meta.json cùng thư mục.
---

  <figure class="hanh-tinh">
    <svg viewBox="0 0 640 340" role="img" aria-labelledby="ht-ten">
      <title id="ht-ten">Một hành tinh có biển, rừng, sông và một mạch vàng, chưa có người nào</title>
      <rect width="640" height="340" fill="var(--troi)"/>
      <g fill="var(--troi-chu)">
        <circle class="sao" cx="52" cy="44" r="1.4"/><circle cx="130" cy="92" r="1"/><circle class="sao" cx="214" cy="28" r="1.2" style="animation-delay:1s"/>
        <circle cx="526" cy="48" r="1.4"/><circle class="sao" cx="596" cy="118" r="1" style="animation-delay:2s"/><circle cx="458" cy="22" r="1"/>
        <circle class="sao" cx="30" cy="190" r="1" style="animation-delay:.5s"/><circle cx="612" cy="262" r="1.2"/><circle class="sao" cx="96" cy="300" r="1" style="animation-delay:1.5s"/>
      </g>
      <defs>
        <clipPath id="dia-cau"><circle cx="320" cy="172" r="126"/></clipPath>
