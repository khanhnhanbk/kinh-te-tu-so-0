---
// Trang 7: Ai làm ra muối? Câu hỏi, số dân, trang cha nằm ở meta.json cùng thư mục.
import KN from '../../components/KN.astro';
---

  <p class="dan-nhap">Gần đúng: 100 ô muối là 100 người <em>chịu nhận</em> muối, chứ không phải 100 người đang có muối. Người làm ra muối chính là những người vốn làm muối: trong chợ 100 người có 16 người như thế. Ngày đầu chỉ họ có muối; muối của cả chợ là muối họ làm thêm mỗi lần đổi được thứ mình cần. Câu hỏi của bạn chạm vào một chuyện lớn của tiền: ai làm ra nó thì được gì, và nếu làm ra quá nhiều thì sao.</p>

  <h2>Thợ muối có một cái lợi riêng</h2>
  <p>Khi muối đã thành tiền, thợ muối không cần đi tìm người cần muối nữa. Cả chợ đều nhận muối, nên họ làm ra bao muối nào là đem mua được ngay thứ mình cần. Người trồng rau phải bán rau lấy muối rồi mới mua được. Thợ muối thì bỏ qua được bước đó.</p>
  <p>Phần lợi này có tên: <strong id="kn-dac-quyen-duc-tien">lợi tức đúc tiền</strong> <em class="tn">(seigniorage)</em>, sách kinh tế còn gọi là thuế đúc tiền. Nó bằng lượng đồ mà tiền mới mua được, trừ đi công làm ra tiền đó. Nếu làm một bao muối tốn công như nuôi một con cá thì thợ muối chẳng lời hơn ai. Nhưng nếu muối dễ làm, chỉ cần ra biển phơi nắng, thì thợ muối đổi chút công lấy rất nhiều đồ. Thử chỉnh xem:</p>

  <div class="thu" id="t7m">
    <p class="nhan">Chợ muối 60 ngày</p>
    <div class="bang-gia">
      <div class="dong-gia"><span>Mỗi thợ muối làm</span><span class="o-so"><button type="button" class="tru" data-o="t7m-lam" aria-label="Bớt">−</button><input id="t7m-lam" type="number" inputmode="decimal" min="0" max="2" step="0.05" value="0.05" aria-label="Mỗi thợ muối làm bao nhiêu bao muối một ngày"><button type="button" class="cong" data-o="t7m-lam" aria-label="Thêm">+</button></span><span>bao muối / ngày</span></div>
      <div class="dong-gia"><span>Cả chợ làm ra</span><span class="o-so"><button type="button" class="tru" data-o="t7m-do" aria-label="Bớt">−</button><input id="t7m-do" type="number" inputmode="numeric" min="20" max="300" step="10" value="80" aria-label="Cả chợ làm ra bao nhiêu món đồ một ngày"><button type="button" class="cong" data-o="t7m-do" aria-label="Thêm">+</button></span><span>món đồ / ngày</span></div>
    </div>
    <div class="hanh-dong" id="t7m-mau" aria-label="Chuyện mẫu"></div>
    <div class="do" aria-live="polite">
      <div><b id="t7m-gia">1</b><span>giá 1 món ngày 60 (bao muối)</span></div>
      <div><b id="t7m-tho">1%</b><span>phần đồ về thợ muối</span></div>
      <div class="vang-chu"><b id="t7m-de">10</b><span>số món 10 bao để dành còn mua được</span></div>
    </div>
    <svg class="bieu-do" id="t7m-bd" viewBox="0 0 600 200" role="img" aria-labelledby="t7m-bd-ten"><title id="t7m-bd-ten">Giá một món đồ tính bằng bao muối qua 60 ngày</title></svg>
    <p class="chu-giai"><span><i class="dau chi"></i>Giá 1 món (bao muối)</span></p>
    <p class="ket-luan" id="t7m-ket" aria-live="polite"></p>
  </div>
  <p class="chu-nho">Cách tính: lúc đầu chợ có 80 bao muối và mỗi ngày cả chợ ăn mất 1% số muối. Mỗi bao muối đổi tay một lần một ngày, nên giá một món bằng số muối đang có chia cho số món làm ra.</p>

  <h2>Nhiều muối hơn, không nhiều đồ hơn</h2>
  <p>Khi thợ muối làm vừa đủ bù phần muối bị ăn mất, giá đứng yên. Khi họ làm nhiều hơn, chợ có thêm muối nhưng không có thêm con cá, cái áo nào. Đồ vẫn chừng ấy mà muối thì nhiều hơn, nên giá mọi thứ tính bằng muối tăng lên. Đó là <strong id="kn-lam-phat">lạm phát</strong> <em class="tn">(inflation)</em>: mỗi bao muối mua được ít đồ hơn trước.</p>
  <p>Nhà kinh tế người Mỹ Irving Fisher viết ý này thành công thức năm 1911: lượng tiền nhân với số lần tiền đổi tay (tốc độ lưu thông của tiền) bằng giá nhân với lượng đồ. Giữ nguyên lượng đồ và số lần đổi tay, nhân đôi lượng tiền thì giá cũng gấp đôi. Ý này gọi là <strong id="kn-thuyet-so-luong-tien">thuyết số lượng tiền</strong> <em class="tn">(quantity theory of money)</em>. Milton Friedman (Nobel 1976) dùng nó để nói rằng lạm phát kéo dài, ở đâu và lúc nào, cũng là chuyện tiền tăng nhanh hơn đồ (mình dịch thoáng). Bấm thử “Chợ làm nhiều đồ hơn”: muối tăng mà đồ cũng tăng theo thì giá gần như đứng yên.</p>

  <h2>Ai được lợi, ai âm thầm chịu thiệt</h2>
  <p>Để ý con số giữa. Khi muối dễ làm, những ngày đầu thợ muối lấy về một phần lớn đồ của chợ, vì họ mua bằng muối mới ở mức giá cũ. Càng về sau giá càng tăng, nên mỗi bao muối mới mua được ít hơn và phần lợi của họ nhỏ dần. Người thiệt là người đang cầm muối để dành: 10 bao cất từ ngày 1 giờ mua được ít món hơn hẳn, dù không ai lấy bao nào khỏi túi họ. Chuyện ai cầm tiền mới trước thì được, ai nhận sau thì thiệt gọi là <strong id="kn-hieu-ung-cantillon">hiệu ứng Cantillon</strong> <em class="tn">(Cantillon effect)</em>, theo tên Richard Cantillon, người viết về nó khoảng năm 1730.</p>

  <h2>Chuyện có thật</h2>
  <p><strong>Núi bạc Potosí.</strong> Từ năm 1545, người Tây Ban Nha khai thác một núi bạc khổng lồ ở Potosí (nay thuộc Bolivia) và chở bạc về châu Âu. Bạc lúc đó là tiền. Trong khoảng một thế kỷ, giá cả ở Tây Ban Nha tăng gấp mấy lần, rồi đà tăng giá lan ra cả châu Âu. Sử gia kinh tế Earl Hamilton (1934) gọi đó là cuộc cách mạng giá cả.</p>
  <p><strong>Vỏ ốc ở Tây Phi.</strong> Vỏ ốc tiền từng là tiền ở nhiều vùng Tây Phi. Người ta nhặt nó tận quần đảo Maldives rồi chở sang bằng tàu. Thế kỷ 19, thương nhân châu Âu chở vào hàng nghìn tấn vỏ ốc, có cả loại nhặt dễ hơn ở bờ biển Đông Phi. Vỏ ốc mất giá dần, và người cất vỏ ốc để dành mất phần lớn của cải (Hogendorn và Johnson, 1986). Đúng như khi bạn bấm “Thuyền chở 400 bao tới”.</p>
  <p>Hai chuyện cùng một bài học: tiền tốt phải <em>khó làm thêm</em>. Vì vậy vàng, thứ phải đào rất vất vả mới có thêm chút ít, giữ được vai trò tiền lâu đến vậy. Và cũng vì vậy, về sau người ta không để ai muốn làm tiền thì làm. Quyền đó dần về tay vua, rồi về nhà nước, như đồng Thái Bình Hưng Bảo đúc dưới thời Đinh mà bạn đã thấy ở trang trước.</p>

  <div class="cau-hoi-lon">
    <p class="nhan">Mảnh ghép thứ bảy cho câu hỏi ngây thơ</p>
    <p>Khi thợ muối làm thêm muối mà chợ không làm thêm đồ, cột muối của thợ muối tăng, nhưng không ai bị lấy bao nào. Vậy ai trả? Câu trả lời là mọi người đang cầm muối. Mỗi bao của họ mua được ít hơn, và tổng phần hụt đó gần đúng bằng phần đồ thợ muối lấy về. Đây là một kiểu tổng bằng không giấu kín: không ai đưa ai cái gì, nhưng phần đồ có sẵn đã được chia lại. Còn khi muối mới đi cùng đồ mới, như lúc chợ làm nhiều đồ hơn, thì giá đứng yên và không ai hụt. Vậy câu “+100k bên này, −100k bên kia” đúng khi tiền tăng nhanh hơn đồ, và sai khi đồ thật cũng tăng.</p>
  </div>

  <details class="gap">
    <summary>Ghi nhớ và từ khóa</summary>
    <ul class="gon">
      <li>Ai làm ra món dùng làm tiền thì có lợi tức đúc tiền: tiền mới mua được đồ, trừ đi công làm ra nó.</li>
      <li>Tiền tăng nhanh hơn đồ thì giá tăng: lạm phát (Fisher 1911, Friedman).</li>
      <li>Người cầm tiền mới trước được lợi; người cầm tiền để dành thì thiệt (Cantillon, khoảng 1730).</li>
      <li>Tiền tốt phải khó làm thêm. Bạc Potosí và vỏ ốc ở Tây Phi cho thấy chuyện gì xảy ra khi tiền dễ có thêm.</li>
    </ul>
    <div class="bang"><table>
      <thead><tr><th>Tiếng Việt</th><th>Tiếng Anh</th><th>Nghĩa ngắn</th></tr></thead>
      <tbody>
        <tr><td>Lợi tức đúc tiền</td><td>seigniorage</td><td>Tiền mới mua được bao nhiêu, trừ công làm ra nó</td></tr>
        <tr><td>Lạm phát</td><td>inflation</td><td>Giá mọi thứ cùng tăng</td></tr>
        <tr><td>Giảm phát</td><td>deflation</td><td>Giá mọi thứ cùng giảm</td></tr>
        <tr><td>Thuyết số lượng tiền</td><td>quantity theory of money</td><td>Tiền tăng nhanh hơn đồ thì giá tăng</td></tr>
        <tr><td>Hiệu ứng Cantillon</td><td>Cantillon effect</td><td>Ai cầm tiền mới trước thì được lợi</td></tr>
        <tr><td>Cung tiền</td><td>money supply</td><td>Lượng tiền đang có trong nền kinh tế</td></tr>
      </tbody>
    </table></div>
  </details>
  <details class="gap">
    <summary>Tự kiểm tra (3 câu)</summary>
    <p><strong>1.</strong> Chợ có 80 bao muối, mỗi ngày làm ra 80 món đồ, mỗi bao đổi tay một lần một ngày. Muối tăng lên 160 bao, đồ vẫn 80 món. Giá một món là bao nhiêu?</p>
    <details class="nho-mo"><summary>Đáp án</summary><p>2 bao muối. Muối gấp đôi, đồ y nguyên, nên giá gấp đôi.</p></details>
    <p style="margin-top:1rem"><strong>2.</strong> Thợ muối và người cất 10 bao muối để dành: khi muối dễ làm, ai được, ai thiệt?</p>
    <details class="nho-mo"><summary>Đáp án</summary><p>Thợ muối được: họ đem muối mới đi mua đồ trước khi giá kịp tăng. Người để dành thiệt: 10 bao của họ mua được ít đồ hơn.</p></details>
    <p style="margin-top:1rem"><strong>3.</strong> Vì sao vàng làm tiền được lâu hơn vỏ ốc?</p>
    <details class="nho-mo"><summary>Đáp án</summary><p>Vì vàng rất khó làm thêm. Không ai đổ thêm vàng vào chợ thật nhanh được, nên giá tính bằng vàng không bị đẩy lên đột ngột.</p></details>
  </details>
  <details class="gap nguon">
    <summary>Nguồn</summary>
    <ol>
      <li>Irving Fisher, <em>The Purchasing Power of Money</em>, 1911 (phương trình trao đổi MV = PT).</li>
      <li>Milton Friedman (Nobel 1976), <em>Inflation: Causes and Consequences</em>, 1963; và <em>The Counter-Revolution in Monetary Theory</em>, 1970. <a href="https://www.nobelprize.org/prizes/economic-sciences/1976/friedman/facts/" target="_blank" rel="noopener">nobelprize.org</a>.</li>
      <li>Richard Cantillon, <em>Essai sur la nature du commerce en général</em>, viết khoảng 1730, in năm 1755.</li>
      <li>Earl J. Hamilton, <em>American Treasure and the Price Revolution in Spain, 1501–1650</em>, 1934.</li>
      <li>Jan Hogendorn và Marion Johnson, <em>The Shell Money of the Slave Trade</em>, Cambridge University Press, 1986.</li>
      <li>N. Gregory Mankiw, <em>Principles of Economics</em>, chương "Money Growth and Inflation".</li>
    </ol>
  </details>

<script is:inline>
(function () {
/* Trang 7: chợ muối. S = số bao muối đang có, Q = số món làm ra mỗi ngày.
   Mỗi ngày: 16 thợ muối làm thêm 16×m bao, cả chợ ăn mất 1% số muối. Giá 1 món = S / Q.
   Phần đồ về tay thợ muối = muối mới / S. */
var THO = 16, NGAY = 60, S0 = 80, AN = 0.01, NS = "http://www.w3.org/2000/svg";
function o(id) { return document.getElementById(id); }
function doc(id) { var e = o(id), v = parseFloat(String(e.value).replace(",", ".")); if (isNaN(v)) v = +e.min; return Math.min(+e.max, Math.max(+e.min, v)); }
function so(n, k) { var m = Math.pow(10, k == null ? 2 : k); return (Math.round(n * m) / m).toLocaleString("vi-VN"); }
var bd = o("t7m-bd"), ket = o("t7m-ket"), soc = 0, Qtang = false;

function chay() {
  var m = doc("t7m-lam"), Q0 = doc("t7m-do"), S = S0, ds = [], thoDau = 0, tho = 0;
  for (var d = 1; d <= NGAY; d++) {
    var moi = THO * m + (soc && d === 20 ? soc : 0);
    S = S * (1 - AN) + moi;
    var Q = Qtang ? Q0 * S / S0 : Q0;
    var phan = (THO * m) / S;
    if (d === 1) thoDau = phan;
    tho = phan;
    ds.push(S / Q);
  }
  return { ds: ds, gia0: S0 / Q0, thoDau: thoDau, tho: tho, m: m };
}
function ve() {
  var r = chay(), ds = r.ds, giaCuoi = ds[ds.length - 1], de = 10 / giaCuoi;
  o("t7m-gia").textContent = so(giaCuoi);
  o("t7m-tho").textContent = so(r.tho * 100, 1) + "%";
  o("t7m-de").textContent = so(de, 1);
  veBD(ds, r.gia0);
  var tl = giaCuoi / r.gia0, cau;
  if (Qtang) cau = "<b>Muối tăng, đồ cũng tăng theo.</b> Giá gần như đứng yên: " + so(r.gia0) + " → " + so(giaCuoi) + " bao một món. Thợ muối vẫn có phần, nhưng không ai cầm muối bị thiệt.";
  else if (soc) cau = "<b>Ngày 20, thuyền chở " + soc + " bao muối tới.</b> Giá nhảy vọt trong một ngày, rồi chỉ hạ chậm khi muối bị ăn dần. Ai cầm muối cũ mất phần lớn sức mua trong chớp mắt.";
  else if (tl > 1.05) cau = "<b>Lạm phát:</b> giá một món đi từ " + so(r.gia0) + " lên " + so(giaCuoi) + " bao, gấp " + so(tl, 1) + " lần. Ngày 1 thợ muối lấy về " + so(r.thoDau * 100, 1) + "% đồ của chợ; tới ngày 60 chỉ còn " + so(r.tho * 100, 1) + "%. 10 bao để dành từ ngày 1 giờ chỉ mua được " + so(de, 1) + " món thay vì " + so(10 / r.gia0, 1) + ".";
  else if (tl < 0.95) cau = "<b>Giảm phát:</b> không đủ muối mới bù phần bị ăn, muối hiếm dần nên giá một món giảm từ " + so(r.gia0) + " xuống " + so(giaCuoi) + " bao. Người cầm muối để dành lại được lợi.";
  else cau = "<b>Giá đứng yên.</b> Thợ muối làm vừa đủ bù phần muối bị ăn mất. Họ chỉ lấy về " + so(r.tho * 100, 1) + "% đồ của chợ mỗi ngày, gần đúng công họ bỏ ra.";
  ket.innerHTML = cau;
}
function veBD(ds, g0) {
  while (bd.lastChild && bd.lastChild.nodeName !== "title") bd.removeChild(bd.lastChild);
  var W = 600, H = 200, L = 40, R = 10, T = 12, B = 26, max = Math.max.apply(null, ds.concat([g0 * 2]));
  var buoc = max <= 2 ? 0.5 : max <= 5 ? 1 : max <= 12 ? 2 : 5; max = Math.ceil(max / buoc) * buoc;
  function x(i) { return L + (W - L - R) * i / (NGAY - 1); }
  function y(v) { return T + (H - T - B) * (1 - v / max); }
  function el(t, at, txt) { var e = document.createElementNS(NS, t); for (var a in at) e.setAttribute(a, at[a]); if (txt != null) e.textContent = txt; bd.appendChild(e); return e; }
  for (var v = 0; v <= max + 1e-9; v += buoc) { el("line", { x1: L, x2: W - R, y1: y(v), y2: y(v), "class": "luoi" }); el("text", { x: L - 6, y: y(v) + 4, "text-anchor": "end", "class": "truc" }, so(v, 1)); }
  [1, 20, 40, 60].forEach(function (d, k, a) { el("text", { x: x(d - 1), y: H - 8, "text-anchor": k === a.length - 1 ? "end" : "middle", "class": "truc" }, "ngày " + d); });
  el("polyline", { points: ds.map(function (v, i) { return x(i) + "," + y(v); }).join(" "), "class": "duong chi" });
}
var MAU = [
  ["Muối khó làm", 0.05, 80, 0, false],
  ["Biển nắng, muối dễ làm", 0.5, 80, 0, false],
  ["Thuyền chở 400 bao tới", 0.05, 80, 400, false],
  ["Không ai làm thêm muối", 0, 80, 0, false],
  ["Chợ làm nhiều đồ hơn", 0.5, 80, 0, true]
];
MAU.forEach(function (c) {
  var b = document.createElement("button"); b.type = "button"; b.className = "nut-nho"; b.textContent = c[0];
  b.addEventListener("click", function () { o("t7m-lam").value = c[1]; o("t7m-do").value = c[2]; soc = c[3]; Qtang = c[4]; danhDau(b); ve(); });
  o("t7m-mau").appendChild(b);
});
function danhDau(b) { o("t7m-mau").querySelectorAll("button").forEach(function (x) { x.setAttribute("aria-pressed", String(x === b)); }); }
document.querySelectorAll("#t7m .o-so button").forEach(function (b) {
  b.addEventListener("click", function () {
    var e = o(b.getAttribute("data-o")), st = +e.step, v = doc(e.id) + (b.classList.contains("cong") ? st : -st);
    e.value = Math.round(Math.min(+e.max, Math.max(+e.min, v)) * 100) / 100; soc = 0; Qtang = false; danhDau(null); ve();
  });
});
document.querySelectorAll("#t7m input").forEach(function (e) { e.addEventListener("input", function () { soc = 0; Qtang = false; danhDau(null); ve(); }); });
danhDau(o("t7m-mau").firstChild);
ve();
})();
</script>
