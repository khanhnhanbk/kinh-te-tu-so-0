var KHO = 100, LAI = 0.1, lon = false;
function o(id) { return document.getElementById(id); }
function doc(id) { var e = o(id), v = parseFloat(String(e.value).replace(",", ".")); if (isNaN(v)) v = +e.min; v = Math.round(v / +e.step) * +e.step; return Math.min(+e.max, Math.max(+e.min, v)); }
function so(v) { return v.toLocaleString("vi-VN", { maximumFractionDigits: 1 }); }
var luoi = o("t11k-luoi");
for (var i = 0; i < 100; i++) luoi.appendChild(document.createElement("span"));
function ve() {
  var vay = doc("t11k-vay"), doi = doc("t11k-doi");
  o("t11k-vay").value = vay; o("t11k-doi").value = doi;
  var phieu = KHO + vay, biDoi = doi / 100 * phieu, nguong = KHO / phieu * 100, ket;
  Array.prototype.forEach.call(luoi.children, function (s, k) {
    if (k < KHO / 5) { s.textContent = "🧂"; s.className = "la-tien"; }
    else if (k < phieu / 5) { s.textContent = "📜"; s.className = "lam-dich-vu"; }
    else { s.textContent = ""; s.className = "da-di"; }
  });
  o("t11k-phieu").textContent = so(phieu);
  o("t11k-muoi").textContent = so(KHO);
  o("t11k-lai").textContent = so(vay * LAI);
  var max = Math.max(KHO, biDoi);
  o("t11k-thanh-kho").style.width = (KHO / max * 100) + "%";
  o("t11k-thanh-doi").style.width = (biDoi / max * 100) + "%";
  o("t11k-kho").textContent = KHO + " bao";
  o("t11k-bi-doi").textContent = so(biDoi) + " bao";
  if (biDoi <= KHO) {
    if (vay === 0) ket = "<b>Kho giữ hộ thuần.</b> Mỗi phiếu có đúng 1 bao muối đằng sau, ai đòi cũng có. Nhưng không ai vay được, và bạn không có đồng lãi nào.";
    else ket = "<b>Đủ muối.</b> Chợ có " + so(phieu) + " phiếu mà kho chỉ có 100 bao: " + so(vay) + " phiếu là tiền mới, sinh ra lúc bạn cho vay. Bạn thu " + so(vay * LAI) + " bao lãi mỗi năm. Kho chịu được tối đa " + so(nguong) + "% người cầm phiếu đòi cùng lúc.";
  } else if (lon) {
    ket = "<b>Kho lớn cho bạn mượn " + so(biDoi - KHO) + " bao.</b> Ai đến đòi cũng nhận đủ muối, nên người chưa đòi thôi lo và tin đồn tắt. Bạn phải trả lãi cao cho kho lớn, nhưng kho của bạn không sập. Người đóng thuyền trả nợ xong thì bạn trả lại kho lớn.";
  } else {
    ket = "<b>Sập kho.</b> " + so(biDoi) + " bao bị đòi mà kho chỉ có 100. Người đến trước lấy đủ, " + so(biDoi - KHO) + " phiếu của người đến sau thành giấy lộn. Lạ ở chỗ: người vay của bạn vẫn sẽ trả nợ. Muối không mất, chỉ là chưa về kho kịp. Kho chỉ chịu được " + so(nguong) + "% người đòi cùng lúc.";
  }
  o("t11k-ket").innerHTML = ket;
}
function datDoi(v, nut) {
  o("t11k-doi").value = v;
  o("t11k-thuong").setAttribute("aria-pressed", String(nut === "thuong"));
  o("t11k-don").setAttribute("aria-pressed", String(nut === "don"));
  ve();
}
o("t11k-thuong").addEventListener("click", function () { datDoi(10, "thuong"); });
o("t11k-don").addEventListener("click", function () { datDoi(50, "don"); });
o("t11k-lon").addEventListener("click", function () { lon = !lon; o("t11k-lon").setAttribute("aria-pressed", String(lon)); ve(); });
document.querySelectorAll("#t11k .o-so button").forEach(function (b) {
  b.addEventListener("click", function () {
    var e = o(b.getAttribute("data-o")), st = +e.step;
    e.value = doc(e.id) + (b.classList.contains("cong") ? st : -st);
    if (e.id === "t11k-doi") datDoi(doc("t11k-doi"), ""); else ve();
  });
});
o("t11k-vay").addEventListener("change", ve);
o("t11k-doi").addEventListener("change", function () { datDoi(doc("t11k-doi"), ""); });
ve();
})();
</script>
